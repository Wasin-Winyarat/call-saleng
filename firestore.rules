rules_version = '2';

// กฎเดียว: ต้อง login (Firebase Auth) ก่อน ถึงจะอ่าน/เขียนได้ทุก collection
// ยังไม่แยกสิทธิ์ตาม role (user/admin/saleng) หรือเจ้าของ document — ดู ACL.md สำหรับสิทธิ์แต่ละบทบาทที่ต้องแปลงเป็น rule ละเอียดกว่านี้ทีหลัง
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
