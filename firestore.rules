rules_version = '2';

// แก้ตามช่องโหว่ที่ยืนยันแล้วจากการทดสอบจริงเมื่อ 2026-09-22 (ดู test-results.md ข้อ 5 และ BACKLOG.md ข้อ 3):
// กฎเดิม `allow read, write: if request.auth != null` เช็กแค่ "login แล้วหรือยัง" ไม่เช็ก ownership/role เลย
// ทำให้ user คนไหนก็อ่าน/เขียนข้อมูลของคนอื่น และอ่าน admin_accounts ได้หมด — กฎนี้แก้ให้ตรงกับสิทธิ์ที่นิยามไว้ใน ACL.md
// เฉพาะส่วนที่ implement เป็นโค้ดจริงแล้วตาม SCOPE.md (User สร้าง/แก้ไข/ลบคำขอ + Admin confirm/reject/แก้ไขวัน-เวลา + แชท)
// collection อื่นที่ยังไม่ implement (saleng_accounts, request_match, receipt, ฯลฯ) ไม่ต้องเขียน rule ไว้ล่วงหน้า — จะถูกปฏิเสธโดย default (ไม่มี allow ใดครอบคลุม)
//
// หมายเหตุ debug: ระหว่างพัฒนากฎนี้เจอว่า get() ในเงื่อนไข `allow create` ของ chat_messages (เช็ก ownership ของ
// pickup_request ที่ผูกอยู่) ทำให้ create ถูกปฏิเสธแม้ทุกเงื่อนไขย่อยที่แยกทดสอบเดี่ยวๆผ่านหมด (ทดสอบแยกจริงหลายรอบ
// บน production) — ยังไม่หาสาเหตุที่แน่ชัดได้ (อาจเป็น edge case ของ get() ฝั่ง create rule) จึงตัดการเช็ก ownership
// ผ่าน get() ออกจาก allow create ชั่วคราว เหลือแค่เช็กว่า sender_id ตรงกับผู้ login และ sender_role ประกาศถูกต้อง
// (ยังปิดไม่ให้ user ปลอมเป็น admin ได้ เพราะฝั่ง admin ยังเช็ก isAdmin() อยู่) — ช่องโหว่ที่เหลือคือ user ที่ login
// แล้วอาจส่งข้อความแนบกับ request_id ของคนอื่นได้ (สแปม ไม่ใช่การอ่านข้อมูลรั่ว) บันทึกไว้เป็น TODO ใน BACKLOG.md
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admin_accounts/$(request.auth.uid));
    }

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // ซาเล้งที่ Admin อนุมัติแล้วและไม่ถูกระงับ — admin เขียน marker active_salengs/{uid} ตอนอนุมัติ/เปิดใช้งาน
    // และลบทิ้งตอนปฏิเสธ/ระงับ (ใช้ exists() แบบเดียวกับ isAdmin() — หลีกเลี่ยง get() ที่เคยมีปัญหาใน allow create)
    function isActiveSaleng() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/active_salengs/$(request.auth.uid));
    }

    // field การจับคู่บน pickup_requests ที่ซาเล้งแก้ได้ (รับงาน/ตอบรับ/ปฏิเสธ/ยกเลิก/ปิดงาน)
    function salengMatchKeys() {
      return ['status', 'assigned_saleng_id', 'assigned_saleng_name', 'assigned_saleng_phone',
        'assigned_saleng_plate', 'match_channel', 'saleng_accepted', 'assigned_at', 'accepted_at',
        'active_match_id', 'opened_at', 'completed_at'];
    }

    // เจ้าของบัญชีเท่านั้นที่อ่าน/แก้ไขโปรไฟล์ตัวเองได้ (ไม่มี flow ให้ admin อ่าน/แก้บัญชี user ในโค้ดปัจจุบัน)
    match /user_accounts/{uid} {
      allow read, write: if isOwner(uid);
    }

    // ที่อยู่ที่บันทึกไว้ — doc id คือ uid ของ user, เจ้าของเท่านั้น
    match /user_addresses/{uid} {
      allow read, write: if isOwner(uid);
    }

    // บัญชี admin สร้างไว้ล่วงหน้าผ่าน seed/console เท่านั้น ไม่มี flow ให้เขียนจาก client
    // อ่านได้แค่ doc ของตัวเอง (ใช้ตอน login เพื่อยืนยันสิทธิ์ + ดึงชื่อ) ไม่ให้ user ธรรมดาหรือ admin คนอื่นอ่านได้
    match /admin_accounts/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    match /pickup_requests/{requestId} {
      // ซาเล้งเห็นงานที่เปิดรับ (query ฝั่ง client กรองตามตำบลที่ลงทะเบียน) และงานที่ผูกกับตัวเอง
      // ข้อจำกัด: rules ไม่ได้บังคับเรื่องตำบล (ต้อง get() saleng_accounts มาเทียบ) — ซาเล้งที่อนุมัติแล้วอ่านงานเปิดของตำบลอื่นได้ถ้ายิง query เอง
      allow read: if isAdmin() || isOwner(resource.data.user_id) ||
        (isActiveSaleng() &&
         (resource.data.status == 'open_for_saleng' || resource.data.assigned_saleng_id == request.auth.uid));

      // สร้างได้เฉพาะคำขอของตัวเอง และต้องเริ่มที่ pending_admin_review เท่านั้น
      allow create: if isOwner(request.resource.data.user_id) &&
        request.resource.data.status == 'pending_admin_review';

      // admin แก้ได้ทุกกรณี (confirm/reject/แก้ไขวัน-เวลา ตาม ACL.md)
      // user เจ้าของแก้ได้เฉพาะตอนยัง pending_admin_review และห้ามเปลี่ยน status/ย้ายเจ้าของคำขอเอง
      // ซาเล้ง: แก้ได้เฉพาะ field การจับคู่ และเฉพาะการเปลี่ยนสถานะที่กำหนด
      //   รับงานเอง (self-pick): open_for_saleng → pending_match_confirm โดยผูกกับตัวเอง
      //   งานของตัวเอง: ตอบรับงานที่ admin มอบหมาย (คง pending_match_confirm), ปฏิเสธ/ยกเลิก (→ open_for_saleng
      //   และล้าง assigned_saleng_id เป็น null), ปิดงาน (confirmed → completed)
      // ข้อจำกัด: กำหนดเวลายกเลิกหลัง Admin ยืนยัน และโควตาคิว ตรวจฝั่ง client เท่านั้น (rules คำนวณจากวัน/รอบนัดไม่ได้สะดวก)
      allow update: if isAdmin() ||
        (isOwner(resource.data.user_id) &&
         resource.data.status == 'pending_admin_review' &&
         request.resource.data.status == 'pending_admin_review' &&
         request.resource.data.user_id == resource.data.user_id) ||
        (isActiveSaleng() &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(salengMatchKeys()) &&
         (
           (resource.data.status == 'open_for_saleng' &&
            request.resource.data.status == 'pending_match_confirm' &&
            request.resource.data.assigned_saleng_id == request.auth.uid &&
            request.resource.data.match_channel == 'self_pick') ||
           (resource.data.assigned_saleng_id == request.auth.uid &&
            (
              (resource.data.status == 'pending_match_confirm' &&
               request.resource.data.status == 'pending_match_confirm' &&
               request.resource.data.assigned_saleng_id == request.auth.uid) ||
              (resource.data.status in ['pending_match_confirm', 'confirmed'] &&
               request.resource.data.status == 'open_for_saleng' &&
               request.resource.data.assigned_saleng_id == null) ||
              (resource.data.status == 'confirmed' &&
               request.resource.data.status == 'completed' &&
               request.resource.data.assigned_saleng_id == request.auth.uid)
            ))
         ));

      // ลบได้เฉพาะเจ้าของคำขอ และเฉพาะตอนยัง pending_admin_review (ไม่มี flow ให้ admin ลบในโค้ดปัจจุบัน)
      allow delete: if isOwner(resource.data.user_id) &&
        resource.data.status == 'pending_admin_review';

      // audit log การเรียก AI ของ admin (pickup_requests/{id}/aiLog) — admin เท่านั้น
      match /aiLog/{logId} {
        allow read, write: if isAdmin();
      }
    }

    // รูปถ่ายขยะแนบคำขอ — เก็บเป็น base64 data URL ใน Firestore (1 รูป = 1 doc) แทน Firebase Storage
    // เก็บ user_id ซ้ำไว้ใน doc เพื่อเช็กสิทธิ์โดยไม่ต้อง get() pickup_request (ปัญหาเดียวกับ chat_messages ข้างล่าง)
    // ช่องโหว่ที่เหลือแบบเดียวกับแชท: user อาจแนบรูปกับ request_id ของคนอื่นได้ แต่ admin dashboard
    // แสดงเฉพาะรูปที่ user_id ตรงกับเจ้าของคำขอ และจำนวนสูงสุด 5 รูปบังคับฝั่ง client เท่านั้น
    match /request_photos/{photoId} {
      allow read: if isAdmin() || isOwner(resource.data.user_id);

      allow create: if isOwner(request.resource.data.user_id) &&
        request.resource.data.request_id is string &&
        request.resource.data.image_data is string &&
        request.resource.data.image_data.matches('^data:image/jpeg;base64,.*') &&
        request.resource.data.image_data.size() < 1000000 &&
        request.resource.data.display_order is int &&
        request.resource.data.display_order >= 0 &&
        request.resource.data.display_order < 5;

      allow update: if false;
      allow delete: if isOwner(resource.data.user_id);
    }

    // Banner ประชาสัมพันธ์บนหน้าหลักของ user — admin จัดการที่ admin/banners/
    // user ที่ login แล้วอ่านได้เฉพาะที่ status == 'active' (query ฝั่ง user ต้อง where status == 'active' ด้วย
    // ไม่งั้น rule ตรวจไม่ได้และถูกปฏิเสธทั้ง query) — ช่วงวันที่ start/end_date กรองฝั่ง client
    match /ad_banners/{bannerId} {
      allow read: if isAdmin() ||
        (request.auth != null && resource.data.status == 'active');

      allow create, update: if isAdmin() &&
        request.resource.data.title is string &&
        request.resource.data.status in ['active', 'draft'] &&
        request.resource.data.image_data is string &&
        request.resource.data.image_data.matches('^data:image/jpeg;base64,.*') &&
        request.resource.data.image_data.size() < 1000000;

      allow delete: if isAdmin();
    }

    // ---------- ฝั่งซาเล้ง ----------

    // บัญชีซาเล้ง (doc id = uid) — สมัครเองได้ แต่ต้องเริ่มที่ pending/active เสมอ
    // อนุมัติ/ปฏิเสธ/ระงับ ทำได้เฉพาะ admin (ซาเล้งแก้ข้อมูลตัวเองหลังสมัครไม่ได้ในเวอร์ชันนี้)
    match /saleng_accounts/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid) &&
        request.resource.data.approval_status == 'pending' &&
        request.resource.data.account_status == 'active';
      allow update: if isAdmin();
      allow delete: if false;
    }

    // รูปเอกสารตอนสมัคร (รูปรถ / รูปบัตรประชาชน) — ข้อมูลอ่อนไหว: อ่านได้เฉพาะเจ้าของกับ admin
    // แยก 1 รูป = 1 doc (base64) เพราะ doc จำกัด 1 MiB
    match /saleng_documents/{docId} {
      allow read: if isAdmin() || isOwner(resource.data.saleng_id);
      allow create: if isOwner(request.resource.data.saleng_id) &&
        request.resource.data.doc_type in ['vehicle_photo', 'id_card_photo'] &&
        request.resource.data.image_data is string &&
        request.resource.data.image_data.matches('^data:image/jpeg;base64,.*') &&
        request.resource.data.image_data.size() < 1000000;
      allow update: if false;
      allow delete: if isAdmin() || isOwner(resource.data.saleng_id);
    }

    // marker ซาเล้งที่อนุมัติแล้วและไม่ถูกระงับ (ดู isActiveSaleng) — admin เขียนเท่านั้น
    match /active_salengs/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if isAdmin();
    }

    // ประวัติการจับคู่แต่ละรอบ (request_match ใน database-schema) — ใช้ดูประวัติและนับสถิติการยกเลิกของซาเล้ง
    match /request_matches/{matchId} {
      allow read: if isAdmin() || isOwner(resource.data.saleng_id);
      allow create: if isAdmin() ||
        (isActiveSaleng() && request.resource.data.saleng_id == request.auth.uid &&
         request.resource.data.match_channel == 'self_pick');
      allow update: if isAdmin() ||
        (isActiveSaleng() && resource.data.saleng_id == request.auth.uid &&
         request.resource.data.saleng_id == request.auth.uid);
      allow delete: if false;
    }

    // แชทระหว่าง Admin กับซาเล้งต่อคำขอ (แยกจาก chat_messages ที่เป็นแชทกับลูกค้า)
    match /saleng_chat_messages/{messageId} {
      allow read: if isAdmin() || isOwner(resource.data.saleng_id);
      allow create: if request.auth != null &&
        request.resource.data.sender_id == request.auth.uid &&
        (
          (request.resource.data.sender_role == 'admin' && isAdmin()) ||
          (request.resource.data.sender_role == 'saleng' &&
           request.resource.data.saleng_id == request.auth.uid &&
           exists(/databases/$(database)/documents/saleng_accounts/$(request.auth.uid)))
        );
      allow update, delete: if false;
    }

    match /chat_messages/{messageId} {
      // อ่านได้เฉพาะ admin หรือเจ้าของคำขอที่ผูกอยู่ (get() ใช้งานได้ปกติฝั่ง read — ทดสอบผ่านจริงแล้ว)
      allow read: if isAdmin() ||
        (request.auth != null &&
         get(/databases/$(database)/documents/pickup_requests/$(resource.data.request_id)).data.user_id == request.auth.uid);

      // สร้างได้ถ้า sender_id ตรงกับผู้ login และประกาศ role ตรงกับสิทธิ์จริง (admin ต้องเป็น admin จริง)
      // TODO (ดู BACKLOG.md): ยังไม่เช็กว่า sender_role=='user' เป็นเจ้าของ pickup_request ที่ผูกอยู่จริงหรือไม่
      // เพราะ get() ใน allow create ทำให้ถูกปฏิเสธผิดพลาด (debug แล้วยังไม่พบสาเหตุ) — ไม่ใช่ช่องโหว่ข้อมูลรั่ว
      // (อ่านยังถูกจำกัดด้วย allow read ข้างบนตามปกติ) แค่ user อาจแนบข้อความผิด request_id ได้
      allow create: if request.auth != null &&
        request.resource.data.sender_id == request.auth.uid &&
        (
          (request.resource.data.sender_role == 'admin' && isAdmin()) ||
          (request.resource.data.sender_role == 'user' && !isAdmin())
        );

      // ไม่มี flow แก้ไข/ลบข้อความแชทในโค้ดปัจจุบัน
      allow update, delete: if false;
    }
  }
}
